rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Any signed-in user can read rounds
    // Write allowed if authenticated (importRound uses arrayUnion for importedBy)
    match /rounds/{roundId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Users can only read their own PDGA tournament data (written by Cloud Function)
    match /pdga_tournaments/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      match /events/{eventId} {
        allow read: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
